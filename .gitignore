# Publish only bridge sources, tests, scripts and documentation.
/*
!/.gitattributes
!/.gitignore
!/LICENSE
!/readme.md
!/THIRD_PARTY_NOTICES.md
!/build.sh
!/arm64_bridge/
/arm64_bridge/*
!/arm64_bridge/CMakeLists.txt
!/arm64_bridge/build_arm64.ps1
!/arm64_bridge/build_arm64.bat
!/arm64_bridge/check_symbols.py
!/arm64_bridge/memcheck.sh
!/arm64_bridge/src/
!/arm64_bridge/tests/
/arm64_bridge/tests/*
!/arm64_bridge/tests/*.cpp
!/arm64_bridge/tests/*.py
!/arm64_bridge/tests/*.ps1

**/__pycache__/
*.pyc
*.apk
*.apks
*.obb
*.so
*.dex
*.class
*.jar
*.log
*.jks
*.keystore
*.pk8
*.pem
*.p12
*.pfx
*.key
*.env
.env
.env.*
local.properties
